# -*- mode: yaml -*-
---
## Deploy CSI NodePlugin
---
kind: DaemonSet
apiVersion: apps/v1
metadata:
  name: kadalu-csi-nodeplugin
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/part-of: kadalu
    app.kubernetes.io/component: csi-driver
    app.kubernetes.io/name: kadalu-csi-nodeplugin
spec:
  selector:
    matchLabels:
      app.kubernetes.io/part-of: kadalu
      app.kubernetes.io/component: csi-driver
      app.kubernetes.io/name: kadalu-csi-nodeplugin
  updateStrategy:
    # Replacing this pod terminates its Gluster FUSE clients. Keep upgrades
    # explicitly node-by-node until mount handoff is proven safe.
    type: OnDelete
  template:
    metadata:
      labels:
        app.kubernetes.io/part-of: kadalu
        app.kubernetes.io/component: csi-driver
        app.kubernetes.io/name: kadalu-csi-nodeplugin
      namespace: {{ namespace }}
    spec:
      serviceAccountName: kadalu-csi-nodeplugin
{% if nodeplugin_tolerations %}
      tolerations:
{% for toleration in nodeplugin_tolerations %}
{% set has_key = "key" in toleration and toleration["key"] is not none %}
{% set has_operator = "operator" in toleration and toleration["operator"] is not none %}
{% set has_value = "value" in toleration and toleration["value"] is not none %}
{% set has_effect = "effect" in toleration and toleration["effect"] is not none %}
{% set has_seconds = "tolerationSeconds" in toleration and toleration["tolerationSeconds"] is not none %}
{% if has_key or has_operator or has_value or has_effect or has_seconds %}
        -
{% if has_key %}
          key: {{ toleration["key"] | tojson }}
{% endif %}
{% if has_operator %}
          operator: {{ toleration["operator"] | tojson }}
{% endif %}
{% if has_value %}
          value: {{ toleration["value"] | tojson }}
{% endif %}
{% if has_effect %}
          effect: {{ toleration["effect"] | tojson }}
{% endif %}
{% if has_seconds %}
          tolerationSeconds: {{ toleration["tolerationSeconds"] | tojson }}
{% endif %}
{% else %}
        - {}
{% endif %}
{% endfor %}
{% else %}
      tolerations: []
{% endif %}
      containers:
        - name: csi-node-driver-registrar
          image: {{ node_driver_registrar_image | tojson }}
          args:
            - "--v=5"
            - "--csi-address=$(ADDRESS)"
            - "--kubelet-registration-path=$(DRIVER_REG_SOCK_PATH)"
            - "--http-endpoint=:9807"
          ports:
            - name: registrar-hlth
              containerPort: 9807
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /healthz
              port: registrar-hlth
            initialDelaySeconds: 30
            timeoutSeconds: 15
            periodSeconds: 10
            failureThreshold: 3
          env:
            - name: ADDRESS
              value: /plugin/csi.sock
            - name: DRIVER_REG_SOCK_PATH
              value: {{ kubelet_dir }}/plugins/kadalu/csi.sock
            - name: KUBE_NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: KADALU_VERSION
              value: "{{ kadalu_version }}"
            - name: K8S_DIST
              value: "{{ k8s_dist }}"
            - name: VERBOSE
              value: "{{ verbose }}"
          volumeMounts:
            - name: plugin-dir
              mountPath: /plugin
            - name: registration-dir
              mountPath: /registration
        - name: kadalu-nodeplugin
          securityContext:
            privileged: true
            capabilities:
              add: ["SYS_ADMIN"]
            allowPrivilegeEscalation: true
          image: {{ csi_image | tojson }}
          env:
            - name: NODE_ID
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: CSI_ENDPOINT
              value: unix://plugin/csi.sock
            - name: KADALU_VERSION
              value: "{{ kadalu_version }}"
            - name: K8S_DIST
              value: "{{ k8s_dist }}"
            - name: VERBOSE
              value: "{{ verbose }}"
            - name: CSI_ROLE
              value: "nodeplugin"
            - name: KUBELET_DIR
              value: "{{ kubelet_dir }}"
          volumeMounts:
            - name: plugin-dir
              mountPath: /plugin
            - name: pods-mount-dir
              mountPath: {{ kubelet_dir }}/pods
              mountPropagation: "Bidirectional"
            - name: glusterfsd-volfilesdir
              mountPath: "/var/lib/gluster"
            - name: gluster-dev
              mountPath: "/dev"
            - name: varlog
              mountPath: /var/log/gluster
            - name: csi-dir
              mountPath: {{ kubelet_dir }}/plugins/kubernetes.io/csi
              mountPropagation: "Bidirectional"
        - name: csi-liveness-probe
          image: {{ liveness_probe_image | tojson }}
          args:
            - "--csi-address=/plugin/csi.sock"
            - "--http-endpoint=:9808"
          # This is deliberately readiness-only. Restarting the node driver
          # would also kill every Gluster FUSE client that it owns.
          readinessProbe:
            httpGet:
              path: /healthz
              port: 9808
            initialDelaySeconds: 10
            timeoutSeconds: 3
            periodSeconds: 10
            failureThreshold: 5
          volumeMounts:
            - name: plugin-dir
              mountPath: /plugin
        - name: kadalu-logging
          image: {{ busybox_image | tojson }}
          imagePullPolicy: IfNotPresent
          command: ["/bin/sh"]
          args: ["-c", "while true; do logcnt=$(/bin/ls /var/log/gluster/ | wc -l); if [ ${logcnt} -gt 0 ]; then break; fi; sleep 5; done; tail -f /var/log/gluster/*.log"]
          volumeMounts:
            - name: varlog
              mountPath: "/var/log/gluster"
      volumes:
        - name: plugin-dir
          hostPath:
            path: {{ kubelet_dir }}/plugins/kadalu
            type: DirectoryOrCreate
        - name: pods-mount-dir
          hostPath:
            path: {{ kubelet_dir }}/pods
            type: Directory
        - name: registration-dir
          hostPath:
            path: {{ kubelet_dir }}/plugins_registry/
            type: Directory
        - name: glusterfsd-volfilesdir
          configMap:
            name: "kadalu-info"
        - name: gluster-dev
          hostPath:
            path: "/dev"
        - name: varlog
          emptyDir: {}
        - name: csi-dir
          hostPath:
            path: {{ kubelet_dir }}/plugins/kubernetes.io/csi/
            type: DirectoryOrCreate
---
## Deploy CSI Provisioner
---
kind: StatefulSet
apiVersion: apps/v1
metadata:
  name: kadalu-csi-provisioner
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/part-of: kadalu
    app.kubernetes.io/component: csi-driver
    app.kubernetes.io/name: kadalu-csi-provisioner
spec:
  serviceName: kadalu-csi-provisioner
  # CreateVolume's cross-pool name lock is local to this controller pod. The
  # operator uses zero replicas only as an upgrade fence; every serving state
  # is therefore clamped to exactly one controller pod.
  replicas: {{ 0 if provisioner_replicas | default(1) == 0 else 1 }}
  selector:
    matchLabels:
      app.kubernetes.io/part-of: kadalu
      app.kubernetes.io/component: csi-driver
      app.kubernetes.io/name: kadalu-csi-provisioner
  template:
    metadata:
      name: csi-provisioner
      namespace: {{ namespace }}
      labels:
        app.kubernetes.io/part-of: kadalu
        app.kubernetes.io/component: csi-driver
        app.kubernetes.io/name: kadalu-csi-provisioner
    spec:
      serviceAccountName: kadalu-csi-provisioner
      containers:
        - name: csi-provisioner
          image: {{ provisioner_image | tojson }}
          args:
            - "--csi-address=$(ADDRESS)"
            - "--timeout=3m"
            - "--leader-election"
            - "--http-endpoint=:9808"
          ports:
            - name: provision-hlth
              containerPort: 9808
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /healthz/leader-election
              port: provision-hlth
            initialDelaySeconds: 10
            timeoutSeconds: 10
            periodSeconds: 20
            failureThreshold: 1
          env:
            - name: ADDRESS
              value: /var/lib/csi/sockets/pluginproxy/csi.sock
            - name: KADALU_VERSION
              value: "{{ kadalu_version }}"
            - name: K8S_DIST
              value: "{{ k8s_dist }}"
            - name: VERBOSE
              value: "{{ verbose }}"
          volumeMounts:
            - name: socket-dir
              mountPath: /var/lib/csi/sockets/pluginproxy/
        - name: kadalu-provisioner
          securityContext:
            privileged: true
            capabilities:
              add: ["CAP_SYS_ADMIN", "SYS_ADMIN"]
            allowPrivilegeEscalation: true
          image: {{ csi_image | tojson }}
          ports:
            - name: driver-health
              containerPort: 9809
              protocol: TCP
          # Mount reconciliation runs behind the live CSI socket so one bad
          # pool cannot take healthy pools offline. This readiness-only marker
          # reports the degraded state without restarting the controller.
          readinessProbe:
            exec:
              command:
                - /bin/sh
                - -c
                - test -f /plugin/storage-ready
            timeoutSeconds: 3
            periodSeconds: 5
            failureThreshold: 1
          livenessProbe:
            httpGet:
              path: /healthz
              port: driver-health
            initialDelaySeconds: 10
            timeoutSeconds: 3
            periodSeconds: 10
            failureThreshold: 5
          env:
            - name: NODE_ID
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: SECRET_GLUSTERQUOTA_SSH_USERNAME
              valueFrom:
                secretKeyRef:
                  name: glusterquota-ssh-secret
                  key: glusterquota-ssh-username
                  optional: true
            - name: CSI_ENDPOINT
              value: unix://plugin/csi.sock
            - name: KADALU_VERSION
              value: "{{ kadalu_version }}"
            - name: K8S_DIST
              value: "{{ k8s_dist }}"
            - name: VERBOSE
              value: "{{ verbose }}"
            - name: CSI_ROLE
              value: "provisioner"
          volumeMounts:
            - name: socket-dir
              mountPath: /plugin
            - name: create-identity-locks
              mountPath: /var/lib/kadalu/create-locks
            - name: glusterfsd-volfilesdir
              mountPath: "/var/lib/gluster"
            - name: gluster-dev
              mountPath: "/dev"
            - name: varlog
              mountPath: "/var/log/gluster"
            - name: secret-volume
              readOnly: true
              mountPath: "/etc/secret-volume"
        - name: kadalu-logging
          image: {{ busybox_image | tojson }}
          imagePullPolicy: IfNotPresent
          command: ["/bin/sh"]
          args: ["-c", "while true; do logcnt=$(/bin/ls /var/log/gluster/ | wc -l); if [ ${logcnt} -gt 0 ]; then break; fi; sleep 5; done; tail -F /var/log/gluster/*.log"]
          volumeMounts:
            - name: varlog
              mountPath: "/var/log/gluster"
        - name: csi-resizer
          image: {{ resizer_image | tojson }}
          args:
            - "--csi-address=$(ADDRESS)"
            - "--timeout=3m"
            - "--leader-election"
            - "--http-endpoint=:9810"
          ports:
            - name: resizer-health
              containerPort: 9810
              protocol: TCP
          livenessProbe:
            httpGet:
              path: /healthz/leader-election
              port: resizer-health
            initialDelaySeconds: 10
            timeoutSeconds: 10
            periodSeconds: 20
            failureThreshold: 1
          env:
            - name: ADDRESS
              value: /var/lib/csi/sockets/pluginproxy/csi.sock
            - name: KADALU_VERSION
              value: "{{ kadalu_version }}"
            - name: K8S_DIST
              value: "{{ k8s_dist }}"
            - name: VERBOSE
              value: "{{ verbose }}"
          volumeMounts:
            - name: socket-dir
              mountPath: /var/lib/csi/sockets/pluginproxy/
        - name: csi-liveness-probe
          image: {{ liveness_probe_image | tojson }}
          args:
            - "--csi-address=/plugin/csi.sock"
            - "--http-endpoint=:9809"
          # Pod readiness requires both this live CSI socket and the separate
          # hosting-volume marker on the driver container. Mount degradation
          # never feeds the liveness probe or restarts the controller.
          readinessProbe:
            httpGet:
              path: /healthz
              port: 9809
            initialDelaySeconds: 10
            timeoutSeconds: 3
            periodSeconds: 5
            failureThreshold: 1
          volumeMounts:
            - name: socket-dir
              mountPath: /plugin
      volumes:
        - name: socket-dir
          emptyDir:
        - name: create-identity-locks
          emptyDir: {}
        - name: glusterfsd-volfilesdir
          configMap:
            name: "kadalu-info"
        - name: gluster-dev
          hostPath:
            path: "/dev"
        - name: varlog
          emptyDir: {}
        - name: secret-volume
          secret:
            secretName: glusterquota-ssh-secret
            defaultMode: 384
            optional: true
