#!/usr/bin/python3
import json
import os
import subprocess
from argparse import ArgumentParser

parser = ArgumentParser()
parser.add_argument("podprefix", help="Pod prefix")
parser.add_argument("-c", help="Container name")
parser.add_argument("-n", help="Node name")
parser.add_argument(
    "--namespace",
    default=os.environ.get("KADALU_NAMESPACE", "kadalu"),
    help="Kadalu namespace (default: KADALU_NAMESPACE or kadalu)",
)

args = parser.parse_args()

pods_output = subprocess.run(
    ["kubectl", "get", "pods", "-n", args.namespace, "-o", "json"],
    check=True,
    capture_output=True,
    text=True,
)
pods = json.loads(pods_output.stdout).get("items", [])
matches = [
    pod
    for pod in pods
    if pod["metadata"]["name"].startswith(f"{args.podprefix}-")
    and (not args.n or pod.get("spec", {}).get("nodeName") == args.n)
]
if not matches:
    parser.error("no matching pod found")

pod_name = min(pod["metadata"]["name"] for pod in matches)
cmd_exec = ["kubectl", "exec", "-it", "-n", args.namespace, pod_name]
if args.c:
    cmd_exec.extend(["-c", args.c])

cmd_exec.extend(["--", "/bin/bash"])
subprocess.run(cmd_exec, check=False)
